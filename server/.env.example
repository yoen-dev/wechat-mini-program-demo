# ============================================================
# 后端配置模板
# 本地开发：复制一份为 .env（cp .env.example .env）再修改。.env 有密码，不要提交到 Git。
# 微信云托管：不用 .env 文件，在云托管控制台「服务设置 → 环境变量」里逐条填写同名变量。
# ============================================================

# ---------- 基础 ----------
# 运行环境：development（开发）/ production（正式，Dockerfile 里已设置）
NODE_ENV=development
# 监听端口（云托管固定 80，Dockerfile 里已设置）
PORT=3000
# 本地开发时上传图片的访问地址前缀
PUBLIC_URL=http://localhost:3000

# ---------- 数据库（MySQL 8 / MariaDB 10.6+） ----------
# 云托管开通 MySQL 后会自动注入 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD，下面的 DB_HOST/DB_PORT/DB_USER/DB_PASSWORD 就不用填，
# 但 DB_NAME 要填（先在云托管 MySQL 里建好这个库，见 docs/项目指引.md）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=escort
DB_PASSWORD=请改成你的数据库密码
DB_NAME=escort
# 启动时自动建表 / 升级表结构
AUTO_MIGRATE=true

# ---------- 第一个管理员账号（数据库里还没有管理员时自动创建） ----------
ADMIN_ACCOUNT=admin
# 初始密码；留空则随机生成并打印在日志里。登录后请马上修改
ADMIN_INIT_PASSWORD=

# ---------- 登录令牌 ----------
# JWT 签名密钥：一定要换成一长串随机字符（可用 `openssl rand -hex 32` 生成），泄露后别人可以伪造登录
JWT_SECRET=请改成一长串随机字符
# 登录有效期（天）
JWT_DAYS=30

# ---------- 微信登录 ----------
# 云托管正式环境：WX_CLOUD=true（openid 由微信放在请求头里；记得关闭服务的「公网访问」）
WX_CLOUD=false
# 本地开发：WX_MOCK=true，模拟 openid
WX_MOCK=true
# 只有不用云托管、自己服务器部署时才需要
WX_APPID=
WX_SECRET=

# ---------- 短信验证码（手机号登录、绑定手机号） ----------
# SMS_MOCK=true 时不真发短信，验证码固定为 SMS_MOCK_CODE（只用于测试！）
SMS_MOCK=true
SMS_MOCK_CODE=123456
# 接入阿里云短信后填写（见 src/services/sms.js）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 微信支付 ----------
# PAY_MOCK=true 时下单 / 充值直接视为支付成功（只用于测试！）
PAY_MOCK=true
# cloud = 云托管自带支付通道（推荐，不需要证书）；v3 = 自己服务器直连
PAY_MODE=cloud
# 商户号
WXPAY_MCHID=
# 云托管环境 ID（控制台左上角，形如 prod-xxxx）和本服务名称
CLOUD_ENV=
CLOUD_SERVICE=api
# 以下只有 PAY_MODE=v3 才需要
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PUBLIC_KEY_PATH=
WXPAY_NOTIFY_URL=

# ---------- 其他 ----------
# 允许跨域访问的网页地址（本地网页版联调用），多个用英文逗号分隔；留空表示全部允许
CORS_ORIGINS=
# 本地开发时上传图片的保存目录（云托管上图片存对象存储，不用这个）
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# 正式环境如果暂时还要用模拟登录 / 支付做内部试运行，设为 true 才能启动（不要长期开着）
ALLOW_UNSAFE_PROD=false
