# ============================================================
# 后端配置文件模板
# 使用方法：复制一份为 .env（cp .env.example .env），再按实际情况修改。
# .env 里有密码和密钥，不要提交到 Git（.gitignore 已忽略）。
# ============================================================

# ---------- 基础 ----------
# 运行环境：development（开发）/ production（正式）
NODE_ENV=development
# 后端监听端口，Nginx 会把 https://你的域名/api 转发到这个端口
PORT=3000
# 对外访问地址（用于拼接上传图片的完整网址），正式环境填 https://你的域名
PUBLIC_URL=http://localhost:3000

# ---------- 数据库（MySQL 8 / MariaDB 10.6+） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=escort
DB_PASSWORD=请改成你的数据库密码
DB_NAME=escort

# ---------- 登录令牌 ----------
# JWT 签名密钥：一定要换成一长串随机字符（可用 `openssl rand -hex 32` 生成），泄露后别人可以伪造登录
JWT_SECRET=请改成一长串随机字符
# 登录有效期（天）
JWT_DAYS=30

# ---------- 微信小程序 ----------
# 没有 AppID 前保持 WX_MOCK=true：微信登录用模拟 openid
WX_MOCK=true
WX_APPID=
WX_SECRET=

# ---------- 短信验证码 ----------
# SMS_MOCK=true 时不真发短信，验证码固定为 SMS_MOCK_CODE（只用于测试！）
SMS_MOCK=true
SMS_MOCK_CODE=123456
# 接入阿里云短信后填写（见 src/services/sms.js）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 微信支付 ----------
# PAY_MOCK=true 时下单 / 充值直接视为支付成功（只用于测试！）
PAY_MOCK=true
# 拿到商户号后填写（见 src/services/pay.js）
WXPAY_MCHID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=

# ---------- 其他 ----------
# 允许跨域访问的前端地址（网页版用），多个用英文逗号分隔；留空表示全部允许
CORS_ORIGINS=
# 上传文件保存目录（相对 server 文件夹）
UPLOAD_DIR=uploads
# 单个上传文件大小上限（MB）
UPLOAD_MAX_MB=5
